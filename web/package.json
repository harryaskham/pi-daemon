{
  "name": "@harryaskham/pi-daemon-dash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "tsc --noEmit -p tsconfig.json && vite build --logLevel error",
    "test": "vitest run src/test",
    "e2e": "playwright test",
    "e2e:nix": "node scripts/check-playwright-browsers.mjs && node scripts/check-browser-launch.mjs && playwright test",
    "e2e:smoke": "node scripts/check-playwright-browsers.mjs && node scripts/check-browser-launch.mjs && playwright test --grep @smoke",
    "e2e:check": "node scripts/check-playwright-browsers.mjs",
    "e2e:check-launch": "node scripts/check-browser-launch.mjs",
    "bundle:report": "node scripts/bundle-report.mjs",
    "capture": "node scripts/capture-artifacts.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-markdown": "6.5.1",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.6",
    "@replit/codemirror-vim": "6.3.0",
    "@tanstack/react-virtual": "3.14.7",
    "codemirror": "6.0.2",
    "lucide-react": "1.25.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
