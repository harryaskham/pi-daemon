+/// bd-05cda9: minimum age before an UNPARSEABLE lock (no readable `pid=`) is
+/// treated as stale. A lock with a readable PID is judged purely on holder
+/// liveness; this floor only guards the corrupt/legacy-lock fallback so a
+/// brand-new lock a racing sync just wrote is never cleared.
+const FILE_SYNC_LOCK_STALE_THRESHOLD: std::time::Duration = std::time::Duration::from_secs(900);
+
+/// bd-05cda9: is the file-sync lock at `path` STALE (no live owner)?
+/// - Readable `pid=<N>`: stale iff that process is not alive (the common case --
+///   a killed/hung sync). A live PID is NEVER stale.
+/// - Unparseable contents: stale only if older than `FILE_SYNC_LOCK_STALE_THRESHOLD`
+///   (a corrupt/legacy lock no live sync owns).
+/// Conservative throughout: any uncertainty resolves to "not stale" so a live
+/// lock is never cleared.
+fn file_sync_lock_is_stale(path: &Path) -> bool {
+    let contents = match std::fs::read_to_string(path) {
+        Ok(c) => c,
+        Err(_) => return false,
+    };
+    if let Some(pid) = parse_file_sync_lock_pid(&contents) {
+        return !file_sync_pid_is_alive(pid);
+    }
+    match std::fs::metadata(path).and_then(|m| m.modified()) {
+        Ok(modified) => modified
+            .elapsed()
+            .map(|age| age >= FILE_SYNC_LOCK_STALE_THRESHOLD)
+            .unwrap_or(false),
+        Err(_) => false,
+    }
+}
+
+/// bd-05cda9: parse `pid=<N>` from a file-sync lock body (`pid=<N> ts=...`).
+fn parse_file_sync_lock_pid(contents: &str) -> Option<u32> {
+    contents
+        .split_whitespace()
+        .find_map(|tok| tok.strip_prefix("pid="))
+        .and_then(|v| v.parse::<u32>().ok())
+}
+
+/// bd-05cda9: is `pid` a live process? Uses `kill(pid, 0)` (no signal sent --
+/// existence/permission probe only), mirroring the workspace's existing liveness
+/// checks. Conservative: only a definitive `ESRCH` ("no such process") counts as
+/// dead; `EPERM` (process exists but not ours) is treated as alive so a lock we
+/// cannot prove dead is never cleared.
+#[cfg(unix)]
+fn file_sync_pid_is_alive(pid: u32) -> bool {
+    let rc = unsafe { libc::kill(pid as libc::pid_t, 0) };
+    if rc == 0 {
+        return true;
+    }
+    std::io::Error::last_os_error().raw_os_error() != Some(libc::ESRCH)
+}
+
+/// bd-05cda9: non-unix fallback -- cannot probe a PID, so conservatively assume
+/// alive (never clear a lock on a platform where we cannot verify the holder is
+/// dead).
+#[cfg(not(unix))]
+fn file_sync_pid_is_alive(_pid: u32) -> bool {
+    true
+}
