+    // `pid=<N>`, so self-heal: if the recorded holder is gone, clear the stale
+    // lock and retry once; only refuse when the holder is genuinely alive.
+    if file_sync_lock_is_stale(&path) {
+        let _ = std::fs::remove_file(&path);
+        if let Some(lock) = try_create_file_sync_lock(&path)? {
+            return Ok(lock);
+        }
+    }
+    Err(CliError::new(format!(
+        "another caco file sync appears to be running for project {project}; lock {} already exists",
+        path.display()
+    )))
+}
