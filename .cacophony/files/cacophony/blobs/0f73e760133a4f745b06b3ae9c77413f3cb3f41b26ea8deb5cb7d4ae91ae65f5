@@ -2948,6 +3037,54 @@ pub(crate) fn dispatch_file_sync(
 mod tests {
     use super::*;
 
+    /// bd-05cda9: the file-sync stale-lock self-heal -- a dead-holder lock is
+    /// detected stale (so it is cleared + retried instead of wedging the fleet),
+    /// a live-holder lock is never cleared, and a young unparseable lock is left
+    /// alone. Unix-gated: the liveness probe (`kill(pid, 0)`) is unix-specific.
+    #[cfg(unix)]
+    #[test]
+    fn file_sync_lock_stale_self_heal_bd_05cda9() {
+        assert_eq!(
+            parse_file_sync_lock_pid("pid=7142 ts=2026-06-23T23:54:33Z"),
+            Some(7142)
+        );
+        assert_eq!(parse_file_sync_lock_pid("garbage no pid here"), None);
+
+        let tmp = tempfile::tempdir().unwrap();
+        let lock = tmp.path().join("state-sync.lock");
+
+        // A dead holder PID -> stale (the wedge case: a killed/hung sync's lock).
+        // Spawn + reap a child so its PID is definitively gone.
+        let mut child = std::process::Command::new("true")
+            .spawn()
+            .expect("spawn true");
+        let dead_pid = child.id();
+        child.wait().expect("reap true");
+        std::fs::write(&lock, format!("pid={dead_pid} ts=2026-06-23T23:54:33Z")).unwrap();
+        assert!(
+            file_sync_lock_is_stale(&lock),
+            "bd-05cda9: a dead-holder lock must be detected stale"
+        );
+
+        // Our own (live) PID -> NOT stale (never clear a live sync's lock).
+        std::fs::write(
+            &lock,
+            format!("pid={} ts=2026-06-23T23:54:33Z", std::process::id()),
+        )
+        .unwrap();
+        assert!(
+            !file_sync_lock_is_stale(&lock),
+            "bd-05cda9: a live-holder lock must NOT be cleared"
+        );
+
+        // Unparseable + young -> NOT stale (conservative; only old corrupt locks).
+        std::fs::write(&lock, "corrupt-no-pid").unwrap();
+        assert!(
+            !file_sync_lock_is_stale(&lock),
+            "bd-05cda9: a young unparseable lock is not cleared"
+        );
+    }
+
