+    fn provider_head_evidence() -> HostedProviderHeadEvidence {
+        let now = Utc::now();
+        HostedProviderHeadEvidence {
+            expected_project: "cacophony".into(),
+            observed_project: "cacophony".into(),
+            expected_repository: "harryaskham/cacophony".into(),
+            observed_repository: "harryaskham/cacophony".into(),
+            expected_pr_number: 42,
+            observed_pr_number: 42,
+            expected_agent_id: "agent-a".into(),
+            observed_agent_id: "agent-a".into(),
+            expected_bead_id: "bd-a".into(),
+            observed_bead_id: "bd-a".into(),
+            expected_generation: "generation-a".into(),
+            observed_generation: "generation-a".into(),
+            submitted_sha: "aaaa".into(),
+            previous_provider_sha: Some("aaaa".into()),
+            previous_observed_at: Some(now - chrono::Duration::minutes(1)),
+            observed_provider_sha: Some("bbbb".into()),
+            observed_at: now,
+            local_generation_sha: Some("aaaa".into()),
+            local_relation_to_provider: HostedHeadRelation::LocalAncestorOfProvider,
+            local_dirty: false,
+            owner_current_bead_id: Some("bd-a".into()),
+            fetch_error: None,
+        }
+    }
+
+    #[test]
+    fn provider_head_clean_fast_forward_and_moved_owner_bd_b81dac() {
+        let mut evidence = provider_head_evidence();
+        let fast_forward = assess_provider_head_update(&evidence);
+        assert_eq!(
+            fast_forward.state,
+            HostedProviderHeadState::FastForwardReady
+        );
+        assert_eq!(fast_forward.code, HostedProviderHeadCode::FastForward);
+        assert!(!fast_forward.owner_moved_on);
+        assert_eq!(fast_forward.provider_sha.as_deref(), Some("bbbb"));
+
+        evidence.owner_current_bead_id = Some("bd-later".into());
+        let moved = assess_provider_head_update(&evidence);
+        assert_eq!(moved.state, HostedProviderHeadState::FastForwardReady);
+        assert!(moved.owner_moved_on);
+        assert!(moved.safe_next_action.contains("isolated generation"));
+        assert!(moved.safe_next_action.contains("do not switch"));
+    }
+
+    #[test]
+    fn provider_head_dirty_ahead_and_diverged_are_preserved_bd_b81dac() {
+        let mut evidence = provider_head_evidence();
+        evidence.local_dirty = true;
+        assert_eq!(
+            assess_provider_head_update(&evidence).code,
+            HostedProviderHeadCode::DirtyLocalGeneration
+        );
+
+        evidence = provider_head_evidence();
+        evidence.local_relation_to_provider = HostedHeadRelation::ProviderAncestorOfLocal;
+        assert_eq!(
+            assess_provider_head_update(&evidence).code,
+            HostedProviderHeadCode::LocalAhead
+        );
+
+        evidence = provider_head_evidence();
+        evidence.local_relation_to_provider = HostedHeadRelation::Diverged;
+        assert_eq!(
+            assess_provider_head_update(&evidence).code,
+            HostedProviderHeadCode::ProviderRewrite
+        );
+
+        evidence.local_generation_sha = Some("cccc".into());
+        assert_eq!(
+            assess_provider_head_update(&evidence).code,
+            HostedProviderHeadCode::Diverged
+        );
+    }
+
+    #[test]
+    fn provider_head_duplicate_stale_and_equal_events_are_harmless_bd_b81dac() {
+        let mut evidence = provider_head_evidence();
+        evidence.local_generation_sha = Some("bbbb".into());
+        evidence.local_relation_to_provider = HostedHeadRelation::Equal;
+        let equal = assess_provider_head_update(&evidence);
+        assert_eq!(equal.state, HostedProviderHeadState::Unchanged);
+        assert_eq!(equal.code, HostedProviderHeadCode::Unchanged);
+
+        evidence.previous_provider_sha = Some("bbbb".into());
+        let duplicate = assess_provider_head_update(&evidence);
+        assert_eq!(duplicate.code, HostedProviderHeadCode::DuplicateEvent);
+
+        evidence.observed_at =
+            evidence.previous_observed_at.unwrap() - chrono::Duration::seconds(1);
+        evidence.observed_provider_sha = Some("cccc".into());
+        let stale = assess_provider_head_update(&evidence);
+        assert_eq!(stale.state, HostedProviderHeadState::Ignored);
+        assert_eq!(stale.code, HostedProviderHeadCode::StaleEvent);
+    }
+
+    #[test]
+    fn provider_head_identity_missing_and_fetch_fail_closed_bd_b81dac() {
+        let mut evidence = provider_head_evidence();
+        evidence.observed_generation = "generation-other".into();
+        assert_eq!(
+            assess_provider_head_update(&evidence).code,
+            HostedProviderHeadCode::IdentityMismatch
+        );
+
+        evidence = provider_head_evidence();
+        evidence.observed_provider_sha = None;
+        assert_eq!(
+            assess_provider_head_update(&evidence).code,
+            HostedProviderHeadCode::MissingProviderHead
+        );
+
+        evidence = provider_head_evidence();
+        evidence.local_generation_sha = None;
+        assert_eq!(
+            assess_provider_head_update(&evidence).code,
+            HostedProviderHeadCode::MissingLocalGeneration
+        );
+
+        evidence = provider_head_evidence();
+        evidence.fetch_error = Some("auth unavailable".into());
+        let fetch = assess_provider_head_update(&evidence);
+        assert_eq!(fetch.code, HostedProviderHeadCode::FetchUnavailable);
+        assert!(fetch.safe_next_action.contains("do not reset or force"));
+
+        evidence = provider_head_evidence();
+        evidence.local_relation_to_provider = HostedHeadRelation::Unknown;
+        assert_eq!(
+            assess_provider_head_update(&evidence).code,
+            HostedProviderHeadCode::MissingAncestryEvidence
+        );
+    }
