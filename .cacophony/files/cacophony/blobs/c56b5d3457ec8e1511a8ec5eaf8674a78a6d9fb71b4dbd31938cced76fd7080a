+#[derive(Debug, Clone, Copy, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+pub enum HostedHeadRelation {
+    Equal,
+    LocalAncestorOfProvider,
+    ProviderAncestorOfLocal,
+    Diverged,
+    Unknown,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+pub struct HostedProviderHeadEvidence {
+    pub expected_project: String,
+    pub observed_project: String,
+    pub expected_repository: String,
+    pub observed_repository: String,
+    pub expected_pr_number: u64,
+    pub observed_pr_number: u64,
+    pub expected_agent_id: String,
+    pub observed_agent_id: String,
+    pub expected_bead_id: String,
+    pub observed_bead_id: String,
+    pub expected_generation: String,
+    pub observed_generation: String,
+    pub submitted_sha: String,
+    pub previous_provider_sha: Option<String>,
+    pub previous_observed_at: Option<DateTime<Utc>>,
+    pub observed_provider_sha: Option<String>,
+    pub observed_at: DateTime<Utc>,
+    pub local_generation_sha: Option<String>,
+    pub local_relation_to_provider: HostedHeadRelation,
+    pub local_dirty: bool,
+    pub owner_current_bead_id: Option<String>,
+    pub fetch_error: Option<String>,
+}
+
+#[derive(Debug, Clone, Copy, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+pub enum HostedProviderHeadState {
+    Unchanged,
+    FastForwardReady,
+    ReconciliationRequired,
+    Ignored,
+    Refused,
+}
+
+#[derive(Debug, Clone, Copy, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+pub enum HostedProviderHeadCode {
+    Unchanged,
+    DuplicateEvent,
+    FastForward,
+    ProviderRewrite,
+    DirtyLocalGeneration,
+    LocalAhead,
+    Diverged,
+    MissingAncestryEvidence,
+    StaleEvent,
+    IdentityMismatch,
+    MissingProviderHead,
+    MissingLocalGeneration,
+    FetchUnavailable,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+pub struct HostedProviderHeadAssessment {
+    pub state: HostedProviderHeadState,
+    pub code: HostedProviderHeadCode,
+    pub message: String,
+    pub submitted_sha: String,
+    pub previous_provider_sha: Option<String>,
+    pub provider_sha: Option<String>,
+    pub local_generation_sha: Option<String>,
+    pub owner_moved_on: bool,
+    pub safe_next_action: String,
+}
+
+fn normalize_sha(value: &str) -> String {
+    value.trim().to_ascii_lowercase()
+}
+
+fn provider_head_assessment(
+    evidence: &HostedProviderHeadEvidence,
+    state: HostedProviderHeadState,
+    code: HostedProviderHeadCode,
+    message: impl Into<String>,
+    next: impl Into<String>,
+) -> HostedProviderHeadAssessment {
+    HostedProviderHeadAssessment {
+        state,
+        code,
+        message: message.into(),
+        submitted_sha: evidence.submitted_sha.clone(),
+        previous_provider_sha: evidence.previous_provider_sha.clone(),
+        provider_sha: evidence.observed_provider_sha.clone(),
+        local_generation_sha: evidence.local_generation_sha.clone(),
+        owner_moved_on: evidence
+            .owner_current_bead_id
+            .as_deref()
+            .is_some_and(|bead| bead != evidence.expected_bead_id),
+        safe_next_action: next.into(),
+    }
+}
+
+/// Pure provider-head update classifier for an isolated immutable generation.
+/// Git ancestry/fetch evidence is supplied by the caller; this function never
+/// touches refs, worktrees, or the author's current checkout (bd-b81dac).
+pub fn assess_provider_head_update(
+    evidence: &HostedProviderHeadEvidence,
+) -> HostedProviderHeadAssessment {
+    let identity_matches = evidence.expected_project == evidence.observed_project
+        && evidence.expected_repository == evidence.observed_repository
+        && evidence.expected_pr_number == evidence.observed_pr_number
+        && evidence.expected_agent_id == evidence.observed_agent_id
+        && evidence.expected_bead_id == evidence.observed_bead_id
+        && evidence.expected_generation == evidence.observed_generation;
+    if !identity_matches {
+        return provider_head_assessment(
+            evidence,
+            HostedProviderHeadState::Refused,
+            HostedProviderHeadCode::IdentityMismatch,
+            "provider-head event does not match the exact project/repository/PR/agent/bead/generation",
+            "preserve every local ref and route the event to the matching generation owner",
+        );
+    }
+    if let Some(error) = evidence
+        .fetch_error
+        .as_deref()
+        .filter(|error| !error.trim().is_empty())
+    {
+        return provider_head_assessment(
+            evidence,
+            HostedProviderHeadState::ReconciliationRequired,
+            HostedProviderHeadCode::FetchUnavailable,
+            format!("provider head could not be fetched: {}", error.trim()),
+            "retry the first-party exact-PR fetch after auth/connectivity recovers; do not reset or force",
+        );
+    }
+    let Some(provider_sha) = evidence
+        .observed_provider_sha
+        .as_deref()
+        .map(normalize_sha)
+        .filter(|sha| !sha.is_empty())
+    else {
+        return provider_head_assessment(
+            evidence,
+            HostedProviderHeadState::ReconciliationRequired,
+            HostedProviderHeadCode::MissingProviderHead,
+            "provider event has no usable head SHA",
+            "re-read the exact PR head through the configured provider wrapper",
+        );
+    };
+    let Some(local_sha) = evidence
+        .local_generation_sha
+        .as_deref()
+        .map(normalize_sha)
+        .filter(|sha| !sha.is_empty())
+    else {
+        return provider_head_assessment(
+            evidence,
+            HostedProviderHeadState::ReconciliationRequired,
+            HostedProviderHeadCode::MissingLocalGeneration,
+            "managed state has no local generation head",
+            "materialize/recover the isolated generation ref; never switch or reset unrelated current work",
+        );
+    };
+
+    if let Some(previous_at) = evidence.previous_observed_at {
+        if evidence.observed_at < previous_at {
+            let duplicate = evidence
+                .previous_provider_sha
+                .as_deref()
+                .is_some_and(|previous| normalize_sha(previous) == provider_sha);
+            return provider_head_assessment(
+                evidence,
+                HostedProviderHeadState::Ignored,
+                if duplicate {
+                    HostedProviderHeadCode::DuplicateEvent
+                } else {
+                    HostedProviderHeadCode::StaleEvent
+                },
+                if duplicate {
+                    "duplicate older provider-head event is already reflected"
+                } else {
+                    "out-of-order provider-head event is older than the durable observation"
+                },
+                "no action",
+            );
+        }
+    }
+    if evidence
+        .previous_provider_sha
+        .as_deref()
+        .is_some_and(|previous| normalize_sha(previous) == provider_sha)
+        && evidence.local_relation_to_provider == HostedHeadRelation::Equal
+    {
+        return provider_head_assessment(
+            evidence,
+            HostedProviderHeadState::Unchanged,
+            HostedProviderHeadCode::DuplicateEvent,
+            "provider and local generation heads are already reconciled",
+            "no action",
+        );
+    }
+    if local_sha == provider_sha || evidence.local_relation_to_provider == HostedHeadRelation::Equal
+    {
+        return provider_head_assessment(
+            evidence,
+            HostedProviderHeadState::Unchanged,
+            HostedProviderHeadCode::Unchanged,
+            "local generation already equals the observed provider head",
+            "record the observation idempotently; do not touch the author's current checkout",
+        );
+    }
+    if evidence.local_dirty {
+        return provider_head_assessment(
+            evidence,
+            HostedProviderHeadState::ReconciliationRequired,
+            HostedProviderHeadCode::DirtyLocalGeneration,
+            "local isolated generation worktree is dirty; provider update cannot be applied safely",
+            "preserve local changes and report submitted/local/provider SHAs for explicit repair",
+        );
+    }
+
+    match evidence.local_relation_to_provider {
+        HostedHeadRelation::LocalAncestorOfProvider => provider_head_assessment(
+            evidence,
+            HostedProviderHeadState::FastForwardReady,
+            HostedProviderHeadCode::FastForward,
+            "clean isolated generation can fast-forward to the observed provider head",
+            if evidence
+                .owner_current_bead_id
+                .as_deref()
+                .is_some_and(|bead| bead != evidence.expected_bead_id)
+            {
+                "fast-forward only the isolated generation ref/worktree and notify the owner; do not switch its current bead checkout"
+            } else {
+                "fast-forward the exact isolated generation through the first-party reconciliation path"
+            },
+        ),
+        HostedHeadRelation::ProviderAncestorOfLocal => provider_head_assessment(
+            evidence,
+            HostedProviderHeadState::ReconciliationRequired,
+            HostedProviderHeadCode::LocalAhead,
+            "local generation contains commits beyond the provider head",
+            "preserve the local generation and require explicit owner reconciliation; never reset or force",
+        ),
+        HostedHeadRelation::Diverged => {
+            let local_was_known_provider = evidence
+                .previous_provider_sha
+                .as_deref()
+                .is_some_and(|previous| normalize_sha(previous) == local_sha)
+                || normalize_sha(&evidence.submitted_sha) == local_sha;
+            provider_head_assessment(
+                evidence,
+                HostedProviderHeadState::ReconciliationRequired,
+                if local_was_known_provider {
+                    HostedProviderHeadCode::ProviderRewrite
+                } else {
+                    HostedProviderHeadCode::Diverged
+                },
+                if local_was_known_provider {
+                    "provider rewrote/rebased the queued PR head; local generation must not be auto-reset"
+                } else {
+                    "local and provider generation histories diverged"
+                },
+                "preserve both heads and route an explicit first-party rebase/repair against the latest provider SHA",
+            )
+        }
+        HostedHeadRelation::Unknown => provider_head_assessment(
+            evidence,
+            HostedProviderHeadState::ReconciliationRequired,
+            HostedProviderHeadCode::MissingAncestryEvidence,
+            "provider/local ancestry is unknown",
+            "fetch and classify exact generation ancestry before any ref mutation",
+        ),
+        HostedHeadRelation::Equal => unreachable!("equal relation returned above"),
+    }
+}
