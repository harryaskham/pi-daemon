+// --- bd-368eaf, bd-1bd973, bd-7624ac: lane-aware foreground validation ---
+
+/// Resume nudges must preserve foreground safety while making hosted required
+/// CI, narrow exceptions, and non-hosted policy explicit.
+#[test]
+fn resumed_worker_nudge_reinforces_lane_aware_foreground_validation() {
+    let message = resumed_worker_nudge(Some("Implement bead bd-7624ac"), None, None);
+    for required in [
+        "directly in the foreground",
+        "smallest exact smoke",
+        "typed hosted queue with required CI",
+        "explicit reason and must stay narrow",
+        "Projects without equivalent hosted enforcement",
+        "run_in_background",
+        "task-output wait loop",
+    ] {
+        assert!(
+            message.contains(required),
+            "bd-7624ac: resume nudge must contain `{required}`, got: {message}"
+        );
+    }
+    for obsolete in ["`cargo test`", "`cargo build`", "`cargo clippy`"] {
+        assert!(
+            !message.contains(obsolete),
+            "bd-7624ac: resume nudge must not revive broad command `{obsolete}`, got: {message}"
         );
+    }
 }
 
