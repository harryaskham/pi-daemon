+/// Public forge PR lifecycle state used by repair-resubmit verification.
+#[derive(Debug, Clone, Copy, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+pub enum HostedPullRequestState {
+    Open,
+    Closed,
+    Merged,
+}
+
+/// Immutable evidence required before a provider repair can clear its blocked
+/// marker and restore the configured queue trigger. This is provider-neutral:
+/// adapters supply their blocked/trigger label names and canonical queue state.
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+pub struct HostedRepairResubmitEvidence {
+    pub provider: String,
+    pub pr_number: u64,
+    pub pr_state: HostedPullRequestState,
+    pub provider_state: HostedQueueState,
+    pub labels: Vec<String>,
+    pub blocked_label: String,
+    pub trigger_label: String,
+    pub expected_owner: String,
+    pub observed_owner: String,
+    pub expected_bead_id: String,
+    pub observed_bead_id: Option<String>,
+    pub expected_generation: String,
+    pub observed_generation: Option<String>,
+    pub returned_head_sha: String,
+    pub current_head_sha: String,
+    pub bead_link_present: bool,
+    pub validated_repair_attempt: bool,
+    pub track_a_active: bool,
+    pub native_auto_merge_armed: bool,
+}
+
+#[derive(Debug, Clone, Copy, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+pub enum HostedRepairResubmitDisposition {
+    Ready,
+    AlreadyRequeued,
+    Refused,
+}
+
+#[derive(Debug, Clone, Copy, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+pub enum HostedRepairResubmitCode {
+    ReadyHeadAdvanced,
+    ReadyValidatedAttempt,
+    AlreadyRequeued,
+    PrNotOpen,
+    OwnerMismatch,
+    BeadMismatch,
+    GenerationMismatch,
+    MissingBeadLink,
+    MissingHeadEvidence,
+    UnchangedHead,
+    ProviderNotBlocked,
+    CompetingLandingPath,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+pub struct HostedRepairResubmitAssessment {
+    pub disposition: HostedRepairResubmitDisposition,
+    pub code: HostedRepairResubmitCode,
+    pub message: String,
+    pub head_advanced: bool,
+    pub remove_blocked_label: bool,
+    pub apply_trigger_label: bool,
+}
+
+impl HostedRepairResubmitAssessment {
+    fn refused(code: HostedRepairResubmitCode, message: impl Into<String>) -> Self {
+        Self {
+            disposition: HostedRepairResubmitDisposition::Refused,
+            code,
+            message: message.into(),
+            head_advanced: false,
+            remove_blocked_label: false,
+            apply_trigger_label: false,
+        }
+    }
+}
+
+fn has_label(labels: &[String], expected: &str) -> bool {
+    labels
+        .iter()
+        .any(|label| label.eq_ignore_ascii_case(expected))
+}
+
+/// Fail-closed pure gate for the future repair-resubmit mutation path.
+///
+/// The verifier owns no provider API calls and performs no state changes. The
+/// mutating consumer must re-read the same evidence immediately before applying
+/// both label operations atomically/idempotently (parent bd-311eab).
+pub fn assess_hosted_repair_resubmit(
+    evidence: &HostedRepairResubmitEvidence,
+) -> HostedRepairResubmitAssessment {
+    if evidence.pr_state != HostedPullRequestState::Open {
+        return HostedRepairResubmitAssessment::refused(
+            HostedRepairResubmitCode::PrNotOpen,
+            "repair resubmit requires an open pull request",
+        );
+    }
+    if evidence.expected_owner != evidence.observed_owner {
+        return HostedRepairResubmitAssessment::refused(
+            HostedRepairResubmitCode::OwnerMismatch,
+            format!(
+                "repair owner mismatch: expected {}, observed {}",
+                evidence.expected_owner, evidence.observed_owner
+            ),
+        );
+    }
+    if evidence.observed_bead_id.as_deref() != Some(evidence.expected_bead_id.as_str()) {
+        return HostedRepairResubmitAssessment::refused(
+            HostedRepairResubmitCode::BeadMismatch,
+            "repair bead association does not match the returned generation",
+        );
+    }
+    if evidence.observed_generation.as_deref() != Some(evidence.expected_generation.as_str()) {
+        return HostedRepairResubmitAssessment::refused(
+            HostedRepairResubmitCode::GenerationMismatch,
+            "repair generation does not match the returned immutable generation",
+        );
+    }
+    if !evidence.bead_link_present {
+        return HostedRepairResubmitAssessment::refused(
+            HostedRepairResubmitCode::MissingBeadLink,
+            "repair resubmit requires the durable bead-to-PR link",
+        );
+    }
+    if evidence.track_a_active || evidence.native_auto_merge_armed {
+        return HostedRepairResubmitAssessment::refused(
+            HostedRepairResubmitCode::CompetingLandingPath,
+            "repair resubmit refuses competing Track A or native auto-merge ownership",
+        );
+    }
+
+    let blocked_label_present = has_label(&evidence.labels, &evidence.blocked_label);
+    let trigger_present = has_label(&evidence.labels, &evidence.trigger_label);
+    // Public labels are the mutation receipt. Treat block-absent + trigger-present
+    // as idempotently requeued even if the asynchronously folded provider record
+    // still says Blocked for one refresh interval.
+    if !blocked_label_present && trigger_present {
+        return HostedRepairResubmitAssessment {
+            disposition: HostedRepairResubmitDisposition::AlreadyRequeued,
+            code: HostedRepairResubmitCode::AlreadyRequeued,
+            message: "provider block is already clear and queue trigger is present".to_string(),
+            head_advanced: !evidence.returned_head_sha.is_empty()
+                && !evidence.current_head_sha.is_empty()
+                && !evidence
+                    .returned_head_sha
+                    .eq_ignore_ascii_case(&evidence.current_head_sha),
+            remove_blocked_label: false,
+            apply_trigger_label: false,
+        };
+    }
+    let blocked = blocked_label_present || evidence.provider_state == HostedQueueState::Blocked;
+    if !blocked {
+        return HostedRepairResubmitAssessment::refused(
+            HostedRepairResubmitCode::ProviderNotBlocked,
+            "provider evidence is neither blocked nor already requeued",
+        );
+    }
+    if evidence.returned_head_sha.trim().is_empty() || evidence.current_head_sha.trim().is_empty() {
+        return HostedRepairResubmitAssessment::refused(
+            HostedRepairResubmitCode::MissingHeadEvidence,
+            "repair resubmit requires returned and current head SHAs",
+        );
+    }
+    let head_advanced = !evidence
+        .returned_head_sha
+        .eq_ignore_ascii_case(&evidence.current_head_sha);
+    if !head_advanced && !evidence.validated_repair_attempt {
+        return HostedRepairResubmitAssessment::refused(
+            HostedRepairResubmitCode::UnchangedHead,
+            "PR head is unchanged and no explicit validated repair attempt exists",
+        );
+    }
+
+    HostedRepairResubmitAssessment {
+        disposition: HostedRepairResubmitDisposition::Ready,
+        code: if head_advanced {
+            HostedRepairResubmitCode::ReadyHeadAdvanced
+        } else {
+            HostedRepairResubmitCode::ReadyValidatedAttempt
+        },
+        message: if head_advanced {
+            "same-owner repair advanced the exact returned generation head; clear block and restore trigger once"
+        } else {
+            "explicit validated repair attempt authorizes idempotent resubmit of the unchanged exact head"
+        }
+        .to_string(),
+        head_advanced,
+        remove_blocked_label: true,
+        apply_trigger_label: !trigger_present,
+    }
+}
