+    fn repair_evidence() -> HostedRepairResubmitEvidence {
+        HostedRepairResubmitEvidence {
+            provider: "aviator".into(),
+            pr_number: 42,
+            pr_state: HostedPullRequestState::Open,
+            provider_state: HostedQueueState::Blocked,
+            labels: vec!["blocked".into()],
+            blocked_label: "blocked".into(),
+            trigger_label: "mergequeue".into(),
+            expected_owner: "agent-a".into(),
+            observed_owner: "agent-a".into(),
+            expected_bead_id: "bd-fix".into(),
+            observed_bead_id: Some("bd-fix".into()),
+            expected_generation: "generation-a".into(),
+            observed_generation: Some("generation-a".into()),
+            returned_head_sha: "aaaa".into(),
+            current_head_sha: "bbbb".into(),
+            bead_link_present: true,
+            validated_repair_attempt: false,
+            track_a_active: false,
+            native_auto_merge_armed: false,
+        }
+    }
+
+    #[test]
+    fn repair_resubmit_ready_and_idempotent_matrix_bd_25085f() {
+        let mut evidence = repair_evidence();
+        let ready = assess_hosted_repair_resubmit(&evidence);
+        assert_eq!(ready.disposition, HostedRepairResubmitDisposition::Ready);
+        assert_eq!(ready.code, HostedRepairResubmitCode::ReadyHeadAdvanced);
+        assert!(ready.remove_blocked_label);
+        assert!(ready.apply_trigger_label);
+        assert!(ready.head_advanced);
+
+        evidence.labels.push("mergequeue".into());
+        let trigger_retained = assess_hosted_repair_resubmit(&evidence);
+        assert_eq!(
+            trigger_retained.disposition,
+            HostedRepairResubmitDisposition::Ready
+        );
+        assert!(!trigger_retained.apply_trigger_label);
+
+        evidence.labels = vec!["mergequeue".into()];
+        evidence.current_head_sha = evidence.returned_head_sha.clone();
+        let replay = assess_hosted_repair_resubmit(&evidence);
+        assert_eq!(
+            replay.disposition,
+            HostedRepairResubmitDisposition::AlreadyRequeued
+        );
+        assert_eq!(replay.code, HostedRepairResubmitCode::AlreadyRequeued);
+        assert!(!replay.remove_blocked_label);
+        assert!(!replay.apply_trigger_label);
+    }
+
+    #[test]
+    fn repair_resubmit_unchanged_head_requires_validated_attempt_bd_25085f() {
+        let mut evidence = repair_evidence();
+        evidence.current_head_sha = evidence.returned_head_sha.clone();
+        let refused = assess_hosted_repair_resubmit(&evidence);
+        assert_eq!(
+            refused.disposition,
+            HostedRepairResubmitDisposition::Refused
+        );
+        assert_eq!(refused.code, HostedRepairResubmitCode::UnchangedHead);
+
+        evidence.validated_repair_attempt = true;
+        let ready = assess_hosted_repair_resubmit(&evidence);
+        assert_eq!(ready.disposition, HostedRepairResubmitDisposition::Ready);
+        assert_eq!(ready.code, HostedRepairResubmitCode::ReadyValidatedAttempt);
+        assert!(!ready.head_advanced);
+    }
+
+    #[test]
+    fn repair_resubmit_identity_and_ownership_refusals_bd_25085f() {
+        let mut evidence = repair_evidence();
+        evidence.observed_owner = "agent-b".into();
+        assert_eq!(
+            assess_hosted_repair_resubmit(&evidence).code,
+            HostedRepairResubmitCode::OwnerMismatch
+        );
+
+        evidence = repair_evidence();
+        evidence.observed_bead_id = Some("bd-other".into());
+        assert_eq!(
+            assess_hosted_repair_resubmit(&evidence).code,
+            HostedRepairResubmitCode::BeadMismatch
+        );
+
+        evidence = repair_evidence();
+        evidence.observed_generation = Some("generation-b".into());
+        assert_eq!(
+            assess_hosted_repair_resubmit(&evidence).code,
+            HostedRepairResubmitCode::GenerationMismatch
+        );
+
+        evidence = repair_evidence();
+        evidence.bead_link_present = false;
+        assert_eq!(
+            assess_hosted_repair_resubmit(&evidence).code,
+            HostedRepairResubmitCode::MissingBeadLink
+        );
+    }
+
+    #[test]
+    fn repair_resubmit_provider_and_competing_path_refusals_bd_25085f() {
+        let mut evidence = repair_evidence();
+        evidence.pr_state = HostedPullRequestState::Closed;
+        assert_eq!(
+            assess_hosted_repair_resubmit(&evidence).code,
+            HostedRepairResubmitCode::PrNotOpen
+        );
+
+        evidence = repair_evidence();
+        evidence.track_a_active = true;
+        assert_eq!(
+            assess_hosted_repair_resubmit(&evidence).code,
+            HostedRepairResubmitCode::CompetingLandingPath
+        );
+
+        evidence = repair_evidence();
+        evidence.native_auto_merge_armed = true;
+        assert_eq!(
+            assess_hosted_repair_resubmit(&evidence).code,
+            HostedRepairResubmitCode::CompetingLandingPath
+        );
+
+        evidence = repair_evidence();
+        evidence.labels.clear();
+        evidence.provider_state = HostedQueueState::Published;
+        assert_eq!(
+            assess_hosted_repair_resubmit(&evidence).code,
+            HostedRepairResubmitCode::ProviderNotBlocked
+        );
+
+        evidence = repair_evidence();
+        evidence.current_head_sha.clear();
+        assert_eq!(
+            assess_hosted_repair_resubmit(&evidence).code,
+            HostedRepairResubmitCode::MissingHeadEvidence
+        );
+    }
+
