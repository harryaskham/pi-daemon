          <span class="btn primary">Primary</span><span class="btn ghost">Secondary</span>
        </div>
        <div class="prow"><span class="rail" style="background:linear-gradient(#8FE3D6,#B48EAD)"></span>
          <span class="av2" style="background:linear-gradient(120deg,#88C0D0,#B48EAD);width:30px;height:30px">A</span>
          <div style="flex:1"><div style="font-size:12.5px;font-weight:700">PriorityRow</div><div style="font-size:10.5px;color:var(--t2)">accent rail · title · meta · trailing</div></div>
        </div>
      </div>
    </div>
  </div>

  <!-- PHONES -->
  <div class="phones">

    <!-- HOME -->
    <div class="col">
      <div class="cap">Home · <b>needs-you cockpit</b></div>
      <div class="phone"><div class="scr">
        <div class="sb"><span>9:41</span><span class="r">
          <svg width="17" height="12" viewBox="0 0 17 12" fill="#EAEFF7"><rect x="0" y="7" width="3" height="5" rx="1"/><rect x="4.5" y="4.5" width="3" height="7.5" rx="1"/><rect x="9" y="2" width="3" height="10" rx="1"/><rect x="13.5" y="0" width="3" height="12" rx="1" opacity=".4"/></svg>
          <svg width="16" height="12" viewBox="0 0 16 12" fill="none"><path d="M1 4.5C4-.5 12-.5 15 4.5" stroke="#EAEFF7" stroke-width="1.6" stroke-linecap="round"/><path d="M4 7.5c2.4-3 5.6-3 8 0" stroke="#EAEFF7" stroke-width="1.6" stroke-linecap="round"/><circle cx="8" cy="10.5" r="1.3" fill="#EAEFF7"/></svg>
          <svg width="24" height="12" viewBox="0 0 24 12" fill="none"><rect x="1" y="1" width="20" height="10" rx="3" stroke="#EAEFF7" stroke-width="1.4"/><rect x="3" y="3" width="14" height="6" rx="1.5" fill="#A3BE8C"/><rect x="22" y="4" width="1.6" height="4" rx="1" fill="#EAEFF7"/></svg>
