          <div class="pr"><span class="rail" style="background:#BF616A"></span>
            <span class="ico" style="background:rgba(191,97,106,.16)"><svg viewBox="0 0 24 24" fill="none"><path d="M12 8v5M12 16.5v.5" stroke="#BF616A" stroke-width="2" stroke-linecap="round"/><circle cx="12" cy="12" r="9" stroke="#BF616A" stroke-width="1.7"/></svg></span>
