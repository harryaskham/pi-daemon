        </div>
        <div class="nav">
          <div class="ni on"><svg viewBox="0 0 24 24" fill="none"><path d="M4 11l8-7 8 7M6 9.5V20h12V9.5" stroke="#88C0D0" stroke-width="1.9" stroke-linejoin="round"/></svg>Home</div>
          <div class="ni"><svg viewBox="0 0 24 24" fill="none"><path d="M4 6h16v10H8l-4 3V6z" stroke="#6A7587" stroke-width="1.9" stroke-linejoin="round"/></svg>Talk</div>
