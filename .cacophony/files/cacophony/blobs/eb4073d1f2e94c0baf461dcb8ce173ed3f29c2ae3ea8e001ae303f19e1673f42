<!doctype html>
<html lang="en"><head><meta charset="utf-8"><style>
:root{
  --canvas:#0B0E14; --glass:rgba(255,255,255,.055); --glass2:rgba(255,255,255,.09);
  --stroke:rgba(255,255,255,.10); --stroke2:rgba(255,255,255,.16);
  --t1:#EAEFF7; --t2:#9DA9BC; --t3:#6A7587;
  --frost:#88C0D0; --frostd:#5E81AC; --purple:#B48EAD; --green:#A3BE8C; --yellow:#EBCB8B; --red:#BF616A;
  --aurora:linear-gradient(120deg,#8FE3D6 0%,#88C0D0 28%,#5E81AC 60%,#B48EAD 100%);
}
*{box-sizing:border-box;margin:0;padding:0;font-family:'Noto Sans','DejaVu Sans',system-ui,sans-serif;-webkit-font-smoothing:antialiased;}
body{background:
  radial-gradient(1100px 700px at 12% -5%,rgba(136,192,208,.16),transparent 60%),
  radial-gradient(1000px 800px at 105% 20%,rgba(180,142,173,.16),transparent 55%),
  radial-gradient(900px 700px at 50% 115%,rgba(94,129,172,.16),transparent 60%),
  #06080C;
  padding:54px 54px 60px;color:var(--t1);}
.board{display:flex;flex-direction:column;gap:34px;width:1392px;}
.boardhead{display:flex;align-items:flex-end;justify-content:space-between;}
.brand{display:flex;align-items:center;gap:16px;}
.mark{width:54px;height:54px;border-radius:16px;background:var(--aurora);box-shadow:0 8px 30px rgba(136,192,208,.45);display:flex;align-items:center;justify-content:center;}
.mark svg{width:30px;height:30px;}
.btitle{font-size:33px;font-weight:800;letter-spacing:-1.1px;}
.btitle .accent{background:var(--aurora);-webkit-background-clip:text;background-clip:text;color:transparent;}
.bsub{font-size:14.5px;color:var(--t2);margin-top:4px;letter-spacing:.1px;}
.badge{font-size:12px;font-weight:700;letter-spacing:1.4px;color:#0B0E14;background:var(--aurora);padding:8px 15px;border-radius:999px;box-shadow:0 6px 22px rgba(136,192,208,.4);}

/* ── design system panel ── */
.dspanel{background:var(--glass);border:1px solid var(--stroke);border-radius:26px;padding:24px 26px;backdrop-filter:blur(22px);
  box-shadow:0 24px 60px rgba(0,0,0,.5),inset 0 1px 0 rgba(255,255,255,.10);display:grid;grid-template-columns:1.15fr 1fr 1.25fr;gap:30px;}
.dscol h4{font-size:11px;letter-spacing:2px;color:var(--t3);font-weight:800;text-transform:uppercase;margin-bottom:15px;}
.swatches{display:flex;flex-wrap:wrap;gap:10px;}
.sw{width:74px;}
.sw i{display:block;height:42px;border-radius:12px;border:1px solid var(--stroke);box-shadow:inset 0 1px 0 rgba(255,255,255,.12);}
.sw span{display:block;font-size:10.5px;color:var(--t2);margin-top:6px;font-weight:600;}
.sw small{display:block;font-size:9px;color:var(--t3);font-family:'DejaVu Sans Mono',monospace;}
.typecol .ds{letter-spacing:-1px;font-weight:800;font-size:30px;line-height:1.1;}
.typecol .ti{font-weight:700;font-size:18px;margin-top:9px;}
.typecol .bd{font-weight:400;font-size:13.5px;color:var(--t2);margin-top:8px;}
.typecol .mt{font-weight:600;font-size:11px;color:var(--t3);letter-spacing:.6px;margin-top:7px;text-transform:uppercase;}
.kit{display:flex;flex-direction:column;gap:13px;}
.kitrow{display:flex;align-items:center;gap:10px;flex-wrap:wrap;}
.pill{font-size:11px;font-weight:700;padding:5px 11px;border-radius:999px;display:inline-flex;align-items:center;gap:6px;}
.pdot{width:7px;height:7px;border-radius:50%;}
.glow-g{box-shadow:0 0 14px rgba(163,190,140,.6);}
.btn{font-size:12.5px;font-weight:700;padding:10px 18px;border-radius:14px;}
.btn.primary{background:var(--aurora);color:#0B0E14;box-shadow:0 8px 22px rgba(136,192,208,.4);}
.btn.ghost{background:var(--glass2);color:var(--t1);border:1px solid var(--stroke2);}
.prow{display:flex;align-items:center;gap:12px;background:var(--glass2);border:1px solid var(--stroke);border-radius:16px;padding:11px 13px;position:relative;overflow:hidden;}
.rail{position:absolute;left:0;top:0;bottom:0;width:4px;}

/* ── phones ── */
.phones{display:flex;gap:30px;}
.col{display:flex;flex-direction:column;align-items:center;gap:14px;}
.cap{font-size:13px;color:var(--t2);font-weight:600;letter-spacing:.3px;}
.cap b{color:var(--frost);}
.phone{width:362px;height:784px;border-radius:46px;padding:11px;background:linear-gradient(#1a1f29,#0c0f16);
  box-shadow:0 40px 90px rgba(0,0,0,.6),0 0 0 2px rgba(255,255,255,.05),inset 0 1px 0 rgba(255,255,255,.10);}
.scr{position:relative;width:100%;height:100%;border-radius:36px;overflow:hidden;background:var(--canvas);display:flex;flex-direction:column;}
.scr::before{content:"";position:absolute;inset:0;background:
  radial-gradient(420px 280px at 80% -8%,rgba(136,192,208,.22),transparent 60%),
  radial-gradient(420px 320px at -10% 30%,rgba(180,142,173,.18),transparent 60%);pointer-events:none;}
.sb{position:relative;height:44px;display:flex;align-items:center;justify-content:space-between;padding:0 26px;font-size:13px;font-weight:600;color:var(--t1);}
.sb .r{display:flex;gap:7px;align-items:center;}
.body{position:relative;flex:1;overflow:hidden;padding:6px 18px 0;}
.eyebrow{font-size:10.5px;letter-spacing:2.2px;font-weight:800;color:var(--frost);opacity:.92;}
.h1{font-size:27px;font-weight:800;letter-spacing:-.9px;color:#fff;margin-top:5px;line-height:1.12;}
.h1 .sm{display:block;font-size:13px;font-weight:500;color:var(--t2);letter-spacing:0;margin-top:6px;}
.chip{font-size:11px;font-weight:700;padding:6px 11px;border-radius:999px;background:var(--glass2);border:1px solid var(--stroke);display:inline-flex;align-items:center;gap:6px;color:var(--t1);}
.card{position:relative;background:var(--glass);border:1px solid var(--stroke);border-radius:22px;backdrop-filter:blur(18px);
  box-shadow:0 16px 40px rgba(0,0,0,.4),inset 0 1px 0 rgba(255,255,255,.10);padding:16px;}
.hero{position:relative;border-radius:24px;overflow:hidden;padding:17px 18px 14px;
  background:linear-gradient(135deg,rgba(143,227,214,.20),rgba(94,129,172,.16) 55%,rgba(180,142,173,.20));
  border:1px solid var(--stroke2);box-shadow:0 18px 46px rgba(0,0,0,.45),inset 0 1px 0 rgba(255,255,255,.16);}
.hero .lbl{font-size:11px;letter-spacing:1.4px;font-weight:800;color:#dfeaf2;text-transform:uppercase;opacity:.9;}
.spark{height:54px;margin:8px 0 4px;}
.statrow{display:flex;gap:10px;}
.stat{flex:1;}
.stat .n{font-size:25px;font-weight:800;letter-spacing:-.6px;color:#fff;}
.stat .l{font-size:10.5px;color:#cdd7e3;letter-spacing:.5px;text-transform:uppercase;margin-top:1px;}
.stat.hot .n{color:#fff;}
.glowpill{box-shadow:0 0 16px rgba(143,227,214,.55);}
.sect{font-size:12px;font-weight:800;letter-spacing:1.4px;color:var(--t3);text-transform:uppercase;margin:17px 2px 11px;}
.pr{position:relative;display:flex;align-items:center;gap:13px;background:var(--glass);border:1px solid var(--stroke);border-radius:18px;padding:13px 14px 13px 17px;overflow:hidden;box-shadow:0 10px 26px rgba(0,0,0,.3);}
.pr .rail{width:4px;}
.pr .ico{width:38px;height:38px;border-radius:12px;flex:none;display:flex;align-items:center;justify-content:center;}
.pr .ico svg{width:20px;height:20px;}
.pr .tt{flex:1;min-width:0;}
.pr .tt .a{font-size:14px;font-weight:700;color:var(--t1);}
.pr .tt .b{font-size:11.5px;color:var(--t2);margin-top:2px;}
.act{font-size:11.5px;font-weight:800;padding:8px 13px;border-radius:11px;background:var(--aurora);color:#0B0E14;flex:none;box-shadow:0 6px 16px rgba(136,192,208,.4);}
.av{width:38px;height:38px;border-radius:50%;background:var(--aurora);flex:none;display:flex;align-items:center;justify-content:center;font-weight:800;color:#0B0E14;font-size:14px;box-shadow:0 0 0 2px rgba(255,255,255,.12);}
/* nav */
.nav{position:relative;height:74px;background:rgba(11,14,20,.72);backdrop-filter:blur(24px);border-top:1px solid var(--stroke);
  display:flex;align-items:center;justify-content:space-around;padding:0 14px 8px;}
.ni{display:flex;flex-direction:column;align-items:center;gap:4px;color:var(--t3);font-size:10px;font-weight:600;}
.ni svg{width:23px;height:23px;}
.ni.on{color:var(--frost);}
.fab{width:54px;height:54px;border-radius:18px;background:var(--aurora);display:flex;align-items:center;justify-content:center;margin-top:-26px;box-shadow:0 12px 30px rgba(136,192,208,.5);}
.fab svg{width:26px;height:26px;}
/* chat */
.idhdr{position:relative;display:flex;align-items:center;gap:12px;padding:8px 2px 14px;}
.bk{width:34px;height:34px;border-radius:11px;background:var(--glass2);border:1px solid var(--stroke);display:flex;align-items:center;justify-content:center;flex:none;}
.bk svg{width:18px;height:18px;}
.day{align-self:center;font-size:11px;color:var(--t3);font-weight:600;margin:4px auto 14px;background:var(--glass);border:1px solid var(--stroke);padding:4px 12px;border-radius:999px;width:max-content;}
.who{font-size:11px;font-weight:800;color:var(--frost);margin:0 0 5px 4px;letter-spacing:.2px;}
.bub{max-width:80%;padding:11px 14px;border-radius:18px;font-size:13.5px;line-height:1.5;margin-bottom:11px;box-shadow:0 8px 22px rgba(0,0,0,.34);}
.bub.them{background:var(--glass2);border:1px solid var(--stroke);color:var(--t1);border-bottom-left-radius:6px;}
.bub.me{background:linear-gradient(135deg,rgba(136,192,208,.30),rgba(94,129,172,.30));border:1px solid var(--stroke2);color:#fff;border-bottom-right-radius:6px;margin-left:auto;}
.bub.stream{border-color:rgba(180,142,173,.5);}
.tdots{display:inline-flex;gap:5px;align-items:center;}
.tdots i{width:7px;height:7px;border-radius:50%;background:var(--purple);box-shadow:0 0 10px rgba(180,142,173,.8);}
.tdots i:nth-child(2){opacity:.7}.tdots i:nth-child(3){opacity:.4}
.abar{position:relative;display:flex;gap:9px;padding:8px 0 14px;}
.abtn{flex:1;text-align:center;font-size:12.5px;font-weight:700;padding:13px;border-radius:15px;background:var(--glass2);border:1px solid var(--stroke);color:var(--t1);}
.abtn.pri{background:var(--aurora);color:#0B0E14;border:none;box-shadow:0 10px 24px rgba(136,192,208,.45);}
/* work */
.seg{position:relative;display:flex;background:var(--glass);border:1px solid var(--stroke);border-radius:15px;padding:5px;gap:4px;margin-bottom:14px;}
.seg div{flex:1;text-align:center;font-size:12px;padding:9px 4px;border-radius:11px;color:var(--t2);font-weight:600;}
.seg div.on{background:var(--aurora);color:#0B0E14;font-weight:800;box-shadow:0 6px 16px rgba(136,192,208,.4);}
.bd{position:relative;display:flex;align-items:center;gap:12px;background:var(--glass);border:1px solid var(--stroke);border-radius:18px;padding:14px 14px 14px 17px;margin-bottom:11px;overflow:hidden;box-shadow:0 10px 26px rgba(0,0,0,.3);}
.bd .pdt{width:11px;height:11px;border-radius:50%;flex:none;}
.bd .tt{flex:1;min-width:0;}
.bd .tt .a{font-size:13.5px;font-weight:700;color:var(--t1);}
.bd .tt .b{font-size:11px;color:var(--t2);margin-top:3px;display:flex;gap:6px;align-items:center;flex-wrap:wrap;}
.lchip{font-size:9.5px;font-weight:700;padding:3px 7px;border-radius:7px;background:var(--glass2);border:1px solid var(--stroke);color:var(--t2);}
.av2{width:28px;height:28px;border-radius:50%;flex:none;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:11px;color:#0B0E14;}
.foot{margin-top:14px;color:var(--t3);font-size:12px;letter-spacing:.2px;text-align:center;}
.foot b{color:var(--frost);}
</style></head>
<body>
<div class="board">

  <div class="boardhead">
    <div class="brand">
      <div class="mark"><svg viewBox="0 0 24 24" fill="none"><path d="M4 14c2-6 6-9 8-9s2 4 0 7-2 5 0 6 5-1 8-4" stroke="#0B0E14" stroke-width="2.2" stroke-linecap="round"/></svg></div>
      <div>
        <div class="btitle">Cacophony for Android — <span class="accent">Aurora Glass</span></div>
        <div class="bsub">A premium, depth-and-materials direction · glassmorphism · one signature aurora accent · glow-on-live · figma-grade · self-rendered on pocket4 (chromium)</div>
