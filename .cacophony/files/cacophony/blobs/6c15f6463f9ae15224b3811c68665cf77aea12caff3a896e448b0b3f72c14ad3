+#!/usr/bin/env python3
+"""Conservative token-free PR path classifier (bd-57ade7).
+
+This foundation only classifies an already-selected PR delta. Workflow callers
+must pass the exact PR/stack base and head, or an exact paths file; the script
+never queries GitHub and never broadens credentials on forked pull requests.
+Unknown, empty, malformed, or unreadable input always selects the full lane.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import subprocess
+import sys
+from dataclasses import asdict, dataclass
+from pathlib import PurePosixPath
+from typing import Iterable, Sequence
+
+CONFIG_EXTENSIONS = {".yaml", ".yml", ".json"}
+PROFILE_DOC_NAMES = {
+    "AGENTS.md",
+    "docs/agents.html",
+    "docs/profile-lifecycle.html",
+    "docs/profiles.html",
+}
+COUPLED_SCRIPTS = {
+    "scripts/profile-lifecycle-audit.py",
+    "scripts/render-profiles-docs.py",
+}
+
+
+@dataclass(frozen=True)
+class Classification:
+    classification: str
+    config_profile_only: bool
+    reason: str
+    files: list[str]
+    matched_files: list[str]
+    unmatched_files: list[str]
+    source: str
+    error: str | None = None
+
+
+def normalize_path(raw: str) -> str | None:
+    value = raw.strip().replace("\\", "/")
+    if not value or value.startswith("/") or "\x00" in value:
+        return None
+    path = PurePosixPath(value)
+    if any(part in {"", ".", ".."} for part in path.parts):
+        return None
+    return path.as_posix()
+
+
+def is_config_profile_path(path: str) -> bool:
+    p = PurePosixPath(path)
+    suffix = p.suffix.lower()
+
+    if path == "AGENTS.md":
+        return True
+    if path.startswith(".cacophony/"):
+        # YAML/JSON declarations and Markdown profile/instruction sources are
+        # configuration; executable Pi/JS/Rust/shell payloads fail full.
+        return suffix in CONFIG_EXTENSIONS or suffix == ".md"
+    if path.startswith("docs/config-schema/"):
+        return suffix in {".html", ".json", ".md"}
+    if path in PROFILE_DOC_NAMES or path in COUPLED_SCRIPTS:
+        return True
+    if path.startswith("plugins/"):
+        parts = p.parts
+        if "agents" in parts:
+            # Materialized Claude profile agents and their colocated hook assets
+            # are validated by the profile/plugin policy lane, not Cargo.
+            return suffix in {".md", ".sh", ".json"} or p.name == ".gitkeep"
+        if "commands" in parts:
+            return suffix in {".md", ".json"}
+        if ".claude-plugin" in parts:
+            return suffix == ".json"
+        return p.name == "README.md"
+    return False
+
+
+def classify_paths(paths: Iterable[str], source: str = "paths") -> Classification:
+    normalized: list[str] = []
+    invalid: list[str] = []
+    for raw in paths:
+        path = normalize_path(raw)
+        if path is None:
+            if raw.strip():
+                invalid.append(raw.strip())
+            continue
+        normalized.append(path)
+    files = sorted(set(normalized))
+    if invalid:
+        return Classification(
+            classification="full",
+            config_profile_only=False,
+            reason="invalid or unsafe path input",
+            files=files,
+            matched_files=[],
+            unmatched_files=sorted(set(invalid)),
+            source=source,
+        )
+    if not files:
+        return Classification(
+            classification="full",
+            config_profile_only=False,
+            reason="empty delta fails closed",
+            files=[],
+            matched_files=[],
+            unmatched_files=[],
+            source=source,
+        )
+
+    matched = [path for path in files if is_config_profile_path(path)]
+    unmatched = [path for path in files if path not in set(matched)]
+    if unmatched:
+        return Classification(
+            classification="full",
+            config_profile_only=False,
+            reason=f"non-config/profile path requires full lanes: {unmatched[0]}",
+            files=files,
+            matched_files=matched,
+            unmatched_files=unmatched,
+            source=source,
+        )
+    return Classification(
+        classification="config-profile-only",
+        config_profile_only=True,
+        reason="every changed path is in the conservative config/profile policy allowlist",
+        files=files,
+        matched_files=matched,
+        unmatched_files=[],
+        source=source,
+    )
+
+
+def git_diff_paths(base: str, head: str) -> list[str]:
+    if not base.strip() or not head.strip():
+        raise ValueError("--base and --head must both be non-empty")
+    proc = subprocess.run(
+        ["git", "diff", "--name-only", "--diff-filter=ACMRD", "-z", base, head, "--"],
+        check=False,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+    )
+    if proc.returncode != 0:
+        detail = proc.stderr.decode("utf-8", errors="replace").strip()
+        raise RuntimeError(f"git diff failed: {detail or f'exit {proc.returncode}'}")
+    return [part.decode("utf-8", errors="surrogateescape") for part in proc.stdout.split(b"\0") if part]
+
+
+def paths_from_file(path: str) -> list[str]:
+    with open(path, "r", encoding="utf-8") as handle:
+        return [line.rstrip("\r\n") for line in handle]
+
+
+def full_on_error(source: str, error: Exception) -> Classification:
+    return Classification(
+        classification="full",
+        config_profile_only=False,
+        reason="classification input failed; full lanes selected conservatively",
+        files=[],
+        matched_files=[],
+        unmatched_files=[],
+        source=source,
+        error=str(error),
+    )
+
+
+def write_github_output(path: str, result: Classification) -> None:
+    with open(path, "a", encoding="utf-8") as handle:
+        handle.write(f"classification={result.classification}\n")
+        handle.write(f"config_profile_only={str(result.config_profile_only).lower()}\n")
+        handle.write(f"reason={result.reason}\n")
+
+
+def parse_args(argv: Sequence[str]) -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--paths-file", help="newline-delimited exact PR-delta paths")
+    parser.add_argument("--base", help="exact PR/stack base commit or ref")
+    parser.add_argument("--head", help="exact PR head commit or ref")
+    parser.add_argument("--github-output", help="append stable outputs to this GitHub output file")
+    parser.add_argument("--pretty", action="store_true", help="pretty-print JSON")
+    return parser.parse_args(argv)
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    args = parse_args(argv or sys.argv[1:])
+    source = "paths-file" if args.paths_file else "git-diff"
+    try:
+        if args.paths_file and (args.base or args.head):
+            raise ValueError("pass either --paths-file or --base/--head, not both")
+        if args.paths_file:
+            paths = paths_from_file(args.paths_file)
+        elif args.base is not None or args.head is not None:
+            if args.base is None or args.head is None:
+                raise ValueError("--base and --head must be supplied together")
+            paths = git_diff_paths(args.base, args.head)
+        else:
+            raise ValueError("one of --paths-file or --base/--head is required")
+        result = classify_paths(paths, source=source)
+    except Exception as error:  # fail closed without suppressing required contexts
+        result = full_on_error(source, error)
+
+    if args.github_output:
+        try:
+            write_github_output(args.github_output, result)
+        except Exception as error:
+            result = full_on_error(source, error)
+    print(json.dumps(asdict(result), indent=2 if args.pretty else None, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
