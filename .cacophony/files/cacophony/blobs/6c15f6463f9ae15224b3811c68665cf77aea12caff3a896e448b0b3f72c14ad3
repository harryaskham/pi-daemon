+#!/usr/bin/env python3
+
+import json
+import subprocess
+import tempfile
+import unittest
+from pathlib import Path
+
+import ci_change_classify as classifier
+
+
+class ChangeClassifierTests(unittest.TestCase):
+    def assert_config_only(self, paths):
+        result = classifier.classify_paths(paths)
+        self.assertEqual(result.classification, "config-profile-only", result)
+        self.assertTrue(result.config_profile_only)
+        self.assertFalse(result.unmatched_files)
+
+    def assert_full(self, paths):
+        result = classifier.classify_paths(paths)
+        self.assertEqual(result.classification, "full", result)
+        self.assertFalse(result.config_profile_only)
+
+    def test_yaml_and_profile_only(self):
+        self.assert_config_only(
+            [
+                ".cacophony/config.yaml",
+                ".cacophony/agents/dev.yaml",
+                ".cacophony/profiles/worker.md",
+            ]
+        )
+
+    def test_generated_profile_docs_and_plugin_agents(self):
+        self.assert_config_only(
+            [
+                "docs/config-schema/profiles.html",
+                "docs/profiles.html",
+                "plugins/caco-agent/agents/worker.md",
+                "plugins/caco-agent/agents/pause-gate.sh",
+            ]
+        )
+
+    def test_profile_plus_rust_is_full(self):
+        self.assert_full([".cacophony/profiles/worker.md", "crates/caco-cli/src/lib.rs"])
+
+    def test_workflow_platform_and_pi_extension_are_full(self):
+        for path in [
+            ".github/workflows/ci.yml",
+            "companion/android/app/build.gradle.kts",
+            "companion/macos/Cacophony/App.swift",
+            ".cacophony/pi/inbox/index.ts",
+            "plugins/caco-agent/pi-extensions/caco-lifecycle.mjs",
+        ]:
+            with self.subTest(path=path):
+                self.assert_full([path])
+
+    def test_unknown_empty_and_unsafe_fail_closed(self):
+        self.assert_full([])
+        self.assert_full(["some/new/surface.xyz"])
+        result = classifier.classify_paths(["../outside.yml"])
+        self.assertEqual(result.classification, "full")
+        self.assertIn("invalid", result.reason)
+
+    def test_order_and_duplicates_are_deterministic(self):
+        result = classifier.classify_paths(
+            [".cacophony/profiles/z.md", ".cacophony/config.yaml", ".cacophony/config.yaml"]
+        )
+        self.assertEqual(
+            result.files,
+            [".cacophony/config.yaml", ".cacophony/profiles/z.md"],
+        )
+
+    def test_cli_missing_file_emits_full_json_and_success(self):
+        script = Path(__file__).with_name("ci_change_classify.py")
+        proc = subprocess.run(
+            ["python3", str(script), "--paths-file", "/definitely/missing"],
+            check=False,
+            text=True,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+        )
+        self.assertEqual(proc.returncode, 0, proc.stderr)
+        result = json.loads(proc.stdout)
+        self.assertEqual(result["classification"], "full")
+        self.assertFalse(result["config_profile_only"])
+        self.assertIn("No such file", result["error"])
+
+    def test_cli_github_output_is_stable(self):
+        script = Path(__file__).with_name("ci_change_classify.py")
+        with tempfile.TemporaryDirectory() as directory:
+            paths = Path(directory, "paths.txt")
+            output = Path(directory, "output.txt")
+            paths.write_text(".cacophony/config.yaml\n", encoding="utf-8")
+            proc = subprocess.run(
+                [
+                    "python3",
+                    str(script),
+                    "--paths-file",
+                    str(paths),
+                    "--github-output",
+                    str(output),
+                ],
+                check=False,
+                text=True,
+                stdout=subprocess.PIPE,
+                stderr=subprocess.PIPE,
+            )
+            self.assertEqual(proc.returncode, 0, proc.stderr)
+            self.assertEqual(
+                output.read_text(encoding="utf-8").splitlines()[:2],
+                ["classification=config-profile-only", "config_profile_only=true"],
+            )
+
+
+if __name__ == "__main__":
+    unittest.main()
