+/// Build a unique test socket path while respecting the smallest common Unix
+/// `sockaddr_un.sun_path` budget. macOS allows only about 104 bytes; Nix shells
+/// can set TMPDIR to a path longer than 60 bytes before the filename is added.
+/// Fall back to `/tmp` only for the test listener path, retaining pid+nanos
+/// uniqueness and leaving production socket placement unchanged (bd-103e56).
+#[cfg(all(test, unix, feature = "runtime"))]
+pub(crate) fn bounded_test_socket_path(
+    temp_dir: &std::path::Path,
+    prefix: &str,
+    pid: u32,
+    nanos: u128,
+) -> std::path::PathBuf {
+    use std::os::unix::ffi::OsStrExt;
+
+    use std::sync::atomic::{AtomicU64, Ordering};
+
+    const SAFE_UNIX_SOCKET_PATH_BYTES: usize = 100;
+    static TEST_SOCKET_SEQUENCE: AtomicU64 = AtomicU64::new(0);
+    let sequence = TEST_SOCKET_SEQUENCE.fetch_add(1, Ordering::Relaxed);
+    let filename = format!("{prefix}-{pid}-{nanos}-{sequence}.sock");
+    let candidate = temp_dir.join(&filename);
+    if candidate.as_os_str().as_bytes().len() < SAFE_UNIX_SOCKET_PATH_BYTES {
+        candidate
+    } else {
+        std::path::Path::new("/tmp").join(filename)
+    }
+}
+
 #[cfg(test)]
 mod tests {
     use super::*;
 
+    #[cfg(all(unix, feature = "runtime"))]
+    #[test]
+    fn test_socket_path_falls_back_for_long_nix_tmpdir_bd_103e56() {
+        use std::os::unix::ffi::OsStrExt;
+
+        let long_tmp = std::path::PathBuf::from("/var/folders")
+            .join("nix-shell")
+            .join("x".repeat(120));
+        let path = bounded_test_socket_path(&long_tmp, "pico-test", 42, 123456789);
+        assert_eq!(path.parent(), Some(std::path::Path::new("/tmp")));
+        assert!(path.as_os_str().as_bytes().len() < 100);
+        let second = bounded_test_socket_path(&long_tmp, "pico-test", 42, 123456789);
+        assert_ne!(
+            path, second,
+            "same-tick parallel tests still need unique sockets"
+        );
+
+        let short_tmp = std::path::Path::new("/tmp/short");
+        let short = bounded_test_socket_path(short_tmp, "pico-test", 42, 123456789);
+        assert_eq!(short.parent(), Some(short_tmp));
+    }
+
